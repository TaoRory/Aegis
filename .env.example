# Sao chép thành .env.local (khi chạy máy) hoặc khai báo trên nền tảng hosting.
# KHÔNG commit file chứa giá trị thật.

# Tên miền production, dùng cho metadata/OG/sitemap. Ví dụ: https://aegis.vn
NEXT_PUBLIC_SITE_URL=

# --- Form liên hệ (gửi email qua Resend: https://resend.com) ---
# Khi thiếu RESEND_API_KEY hoặc CONTACT_TO_EMAIL, form hiển thị trạng thái "chưa kết nối" và không gửi.
RESEND_API_KEY=
# Email nhận thông tin từ form
CONTACT_TO_EMAIL=
# (Tùy chọn) Địa chỉ gửi trên tên miền đã xác minh trong Resend, ví dụ: "Aegis Website <no-reply@aegis.vn>"
# Bỏ trống sẽ dùng onboarding@resend.dev (chỉ gửi được tới email của chính tài khoản Resend).
CONTACT_FROM_EMAIL=
